/**
 * Наполняет гугл-форму анкетой для запуска офиса.
 * Как пользоваться: открыть форму → Расширения → Apps Script →
 * вставить этот код → Выполнить (Run) → разрешить доступ.
 * Форма наполнится за несколько секунд.
 */
function napolnitAnketu() {
  const f = FormApp.getActiveForm()

  // чистим то, что было, чтобы не дублировалось при повторном запуске
  const bylo = f.getItems()
  for (let i = bylo.length - 1; i >= 0; i--) f.deleteItem(bylo[i])

  f.setTitle('Анкета для запуска офиса')
  f.setDescription(
    'Отвечай своими словами, как удобно. Чем подробнее ответишь, тем меньше офис будет ' +
    'переспрашивать потом. Если на какой-то вопрос ответа пока нет - так и напиши, это нормально.'
  )
  f.setProgressBar(true)
  f.setCollectEmail(false)

  const razdel = (t, o) => { const s = f.addSectionHeaderItem().setTitle(t); if (o) s.setHelpText(o); }
  const abzac = (t, o, ob) => {
    const q = f.addParagraphTextItem().setTitle(t)
    if (o) q.setHelpText(o)
    q.setRequired(!!ob)
  }
  const stroka = (t, o, ob) => {
    const q = f.addTextItem().setTitle(t)
    if (o) q.setHelpText(o)
    q.setRequired(!!ob)
  }

  // ── блог ───────────────────────────────────────────────────────────────────
  razdel('Про блог')

  abzac('О чём твой блог и для кого?', 'Своими словами, как объяснила бы подруге', true)

  abzac('Ссылки на все аккаунты, где ты ведёшь блог', 'И отметь, какой из них основной', true)

  abzac('Текущие цифры', 'Сколько подписчиков, какой средний охват у ролика, сколько выкладываешь в неделю')

  abzac('На чём зарабатываешь сейчас?', 'Реклама, свой продукт, услуги, партнёрки. Примерно сколько в месяц выходит')

  abzac('Цель на ближайшие три месяца - в цифре', 'Что важнее: подписчики, заявки или деньги')

  abzac(
    'Какая рутина съедает больше всего времени?',
    'Прикинь примерные часы в неделю на каждое: придумывать идеи, писать сценарии, снимать, ' +
    'монтировать, писать тексты, отвечать в директ'
  )

  // ── конкуренты ─────────────────────────────────────────────────────────────
  razdel('Про конкурентов и ориентиры')

  abzac('Пять-десять аккаунтов, за кем следишь или на кого ориентируешься', 'Пришли ссылками, каждую с новой строки', true)

  abzac('Что у них нравится, а что раздражает?')

  abzac('Твои пять самых залетевших роликов и постов', 'Ссылками. И два-три, которые ты считала удачными, а они не зашли')

  // ── голос ──────────────────────────────────────────────────────────────────
  razdel(
    'Про твой голос',
    'Это нужно, чтобы офис писал твоим языком, а не как робот. Самая важная часть анкеты.'
  )

  abzac(
    'Пришли свои тексты или ссылки на ролики, где ты говоришь сама',
    'Двадцать и больше текстов (подойдёт выгрузка постов) или десять ссылок на ролики',
    true
  )

  abzac('Табу: темы, которые не трогаем, и слова, которые ты никогда не используешь')

  stroka('К аудитории обращаешься на «ты» или на «вы»?')

  // ── техника ────────────────────────────────────────────────────────────────
  razdel('Про технику')

  const os = f.addMultipleChoiceItem()
  os.setTitle('Какой у тебя компьютер?')
    .setChoiceValues(['Мак (MacBook, iMac)', 'Windows', 'Не знаю'])
    .setRequired(true)

  stroka('Какая версия системы?', 'Если не знаешь - так и напиши, подскажем где посмотреть')

  abzac('На что снимаешь, где хранишь исходники, чем монтируешь сейчас?')

  abzac('Есть ли у тебя уже платные сервисы или аккаунты для работы с блогом?')

  abzac('Кто ещё помогает с блогом?', 'Монтажёр, ассистент, смм. Что они делают руками')

  // ── деньги ─────────────────────────────────────────────────────────────────
  razdel('Про продукт и деньги')

  abzac('Что продаёшь, по какой цене, как к тебе приходят покупатели сейчас?')

  abzac('Есть сайт, лендинг или воронка?', 'Пришли ссылки')

  abzac('Пробовала работать с нейросетями раньше?', 'Что именно не понравилось')

  // ── ожидания ───────────────────────────────────────────────────────────────
  razdel('Про ожидания')

  abzac('Что офис должен уметь на первой неделе, чтобы ты сказала «работает»?', '', true)

  const kak = f.addMultipleChoiceItem()
  kak.setTitle('Как тебе удобнее работать?')
    .setChoiceValues([
      'Сама нажимать кнопки и отвечать на вопросы офиса',
      'Чтобы всё сделали за меня и просто показали результат',
      'Как получится, разберёмся по ходу',
    ])

  f.setConfirmationMessage('Спасибо. Этого хватит, чтобы собрать офис под тебя.')

  Logger.log('Готово: вопросов ' + f.getItems().length)
}
