#!/bin/bash
# Двойной клик по этому файлу открывает офис.
cd "$(dirname "$0")" || exit 1

if ! command -v node >/dev/null 2>&1; then
  cat <<'TXT'

  Не хватает одной программы

  Для панели офиса нужна программа Node, а её на этом маке пока нет.
  Похоже, установка ещё не пройдена.

  Что сделать:
  1. Открой файл УСТАНОВКА.md в этой же папке
  2. Пройди шаг 1 оттуда: там же ставится Node (это один раз, дальше не понадобится)
  3. Вернись и запусти этот файл снова

TXT
  read -r -p "  Нажми Enter, чтобы закрыть окно "
  exit 1
fi

clear
echo ""
echo "  Открываю офис…"
node panel/server.js
