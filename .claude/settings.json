{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node panel/server.js)",
      "Bash(python3 scripts/*)",
      "Bash(python3 .agents/skills/*)",
      "Bash(bash scripts/*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(open results/*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/secrets*)",
      "Read(**/credentials*)",
      "Edit(**/.env)",
      "Write(**/.env)",

      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.codex/hooks.json)",
      "Write(.codex/hooks.json)",
      "Edit(.codex/hooks/*)",
      "Write(.codex/hooks/*)",
      "Edit(.codex/config.toml)",
      "Write(.codex/config.toml)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(telnet:*)",
      "Bash(ftp:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ssh:*)",
      "Bash(sftp:*)",
      "Bash(mail:*)",
      "Bash(sendmail:*)",
      "Bash(osascript:*)",

      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(brew install:*)",
      "Bash(brew:*)",
      "Bash(gem install:*)",
      "Bash(cargo install:*)",
      "Bash(go install:*)",
      "Bash(winget:*)",
      "Bash(choco:*)",
      "Bash(git clone:*)",

      "Bash(python3 -c:*)",
      "Bash(python -c:*)",
      "Bash(node -e:*)",
      "Bash(perl -e:*)",
      "Bash(ruby -e:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(eval:*)",
      "Bash(chmod +x karantin/*)",
      "Bash(karantin/*)",
      "Bash(./karantin/*)",
      "Read(karantin/**/*.sh)",
      "Read(karantin/**/*.exe)",
      "Read(karantin/**/*.command)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(*--dangerously-skip-permissions*)",
      "Bash(git push:*)",
      "Bash(gh:*)"
    ]
  }
}
