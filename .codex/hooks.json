{
  "description": "Защита офиса для Codex: сторож команд и сторож секретов. Путь к сторожам берётся от корня папки офиса через git, поэтому файл один и тот же на любом компьютере и не пересобирается.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "^Bash$",
        "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/deny-guard.py\"", "timeout": 10, "statusMessage": "проверяю команду" } ] },
      { "matcher": "apply_patch|Edit|Write",
        "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/secret-guard.py\"", "timeout": 10, "statusMessage": "проверяю путь" } ] }
    ]
  }
}
